# Copy to `.env` and fill in values. Never commit `.env`.

# =============================================================================
# Django (required)
# =============================================================================
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# true = development; false in production
DJANGO_DEBUG=true

# Comma-separated, no spaces (or spaces OK if quoted per line in shell — here CSV)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: true = allow any origin (dev only). In production set false and use CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com,https://www.your-frontend.example.com

# When using HTTPS / reverse proxy (production)
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true

# Optional: SQLite filename relative to project root (default db.sqlite3)
# DJANGO_SQLITE_NAME=db.sqlite3

# Optional: PostgreSQL (e.g. AWS RDS). Requires psycopg (see requirements.txt).
# DJANGO_DATABASE_BACKEND=postgresql
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=your-cluster.region.rds.amazonaws.com
# POSTGRES_PORT=5432
# RDS / managed Postgres: use TLS (recommended)
# POSTGRES_SSLMODE=require
# Reuse DB connections (seconds). Huge win vs new TCP+TLS per request on remote Postgres (default 600).
# DJANGO_DB_CONN_MAX_AGE=600
# DJANGO_DB_CONN_MAX_AGE=0

# Optional
# DJANGO_LANGUAGE_CODE=en-us
# DJANGO_TIME_ZONE=UTC
# DJANGO_LOGS_DIR=/var/log/gymapp
#
# Logging: gymapp logger + RotatingFileHandler (gymapp.log). Root WARNING+ also goes to file.
# DJANGO_LOG_LEVEL=DEBUG   # default DEBUG when DJANGO_DEBUG=true, else INFO
# DJANGO_LOG_TO_CONSOLE=true   # default true when DEBUG, else false — print logs to stderr
# DJANGO_LOG_FILE_MAX_BYTES=10485760
# DJANGO_LOG_FILE_BACKUP_COUNT=5

# =============================================================================
# Customer password hashing (optional extra secret)
# =============================================================================
# CUSTOMER_PASSKEY=

# =============================================================================
# Razorpay
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =============================================================================
# Email
# =============================================================================
# For Gmail: use the same account for SMTP and optionally DEFAULT_FROM_EMAIL (use an App Password).
DEFAULT_FROM_EMAIL=noreply@gymapp.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Team inbox: new signups + home-page enquiries (default crystal.gym.in@gmail.com)
CRYSTAL_TEAM_NOTIFY_EMAIL=crystal.gym.in@gmail.com
# NEW_USER_NOTIFY_ENABLED=true
# NEW_USER_NOTIFY_SUBJECT=New potential client – Crystal Gym
# SITE_ENQUIRY_EMAIL_SUBJECT=Website enquiry – Crystal Gym
# SERVICE_ENQUIRY_EMAIL_SUBJECT=Service enquiry – Crystal Gym
# CLIENT_SUPPORT_EMAIL_SUBJECT_PREFIX=[Crystal Gym]

OTP_EXPIRE_MINUTES=10
OTP_EMAIL_SUBJECT=Your OTP Code
OTP_PASSWORD_RESET_EMAIL_SUBJECT=Your password reset code
PAYMENT_CONFIRMATION_EMAIL_SUBJECT=Payment confirmed – GymApp
# CRYSTAL_LEAD_OWNER_EMAIL_SUBJECT=

# =============================================================================
# Auth tokens
# =============================================================================
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_PASSWORD_RESET_MINUTES=60

# =============================================================================
# Google Sign-In
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=

# =============================================================================
# Admin dashboard API (/api/admin/*) — access is by Customer.role == 0 (admin).
# Grant via Django admin / shell / data migration, not an env variable.
# =============================================================================

# =============================================================================
# S3 — gym image uploads (POST /api/businesses/<slug>/images/)
# Objects: {slug}/{uuid}.ext — bucket should allow public read on these keys (or use CloudFront URL prefix).
# Credentials: set both keys below, OR on EC2/ECS with IAM role set GYM_IMAGES_USE_DEFAULT_AWS_CREDENTIALS=true,
# OR use ~/.aws/credentials. On dev machines without keys, do not enable default chain (avoids slow IMDS timeouts).
# =============================================================================
# AWS_S3_GYM_IMAGES_BUCKET=your-bucket-name
# AWS_S3_REGION_NAME=ap-south-1
# If the bucket is in another region than AWS_S3_REGION_NAME, set this (e.g. us-east-1) or URLs/embeds can PermanentRedirect:
# AWS_S3_GYM_IMAGES_BUCKET_REGION=us-east-1
# Presigned GET URLs in API image_url (default on). Set false only if objects are public and you want non-expiring URLs:
# AWS_S3_GYM_IMAGES_USE_PRESIGNED_GET=false
# Presigned image_url lifetime in seconds (default 3600 = 1 hour; max 604800):
# AWS_S3_GYM_IMAGES_PRESIGNED_EXPIRES=3600
# GYM_IMAGES_USE_DEFAULT_AWS_CREDENTIALS=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Aliases (either pair works; do not commit real values):
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional CloudFront or custom origin base (no trailing slash):
# AWS_S3_GYM_IMAGES_URL_PREFIX=https://dxxxxxxxx.cloudfront.net
# Optional: restrict S3 CORS to your frontends (comma-separated). Empty = "*" when running configure command.
# AWS_S3_GYM_IMAGES_CORS_ORIGINS=https://www.crystal-co.in,https://crystal-co.in
#
# Public read so <img src="image_url"> works — use a dedicated bucket; then run (once per bucket):
#   python manage.py configure_s3_gym_bucket --dry-run
#   python manage.py configure_s3_gym_bucket --relax-public-access-block
# IAM user/role needs: s3:PutBucketPolicy, s3:PutBucketCORS, s3:PutPublicAccessBlock (for --relax-public-access-block).
